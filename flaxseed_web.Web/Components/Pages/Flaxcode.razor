@page "/flaxcode"
@using flaxseed_web.Web;
@using flaxseed_web.Web.Models;
@using SixLabors.ImageSharp;
@using SixLabors.ImageSharp.PixelFormats;
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]

@inject FlaxcodeApiClient FlaxcodeApi

<head>
    <PageTitle>Flaxcode</PageTitle>
</head>



<body>
    <h1>Flaxcode</h1>
    <div> 
        <form method="post" @onsubmit="Submit" @formname="flaxcode-input-form"> 
            <AntiforgeryToken /> 
            <div> 
                <label> 
                    Identifier:
                    <InputText @bind-Value="Model!.input" />
                </label> 
                <label> 
                    Identifier:
                    <textarea @name="textarea" @style="width:250px;height:150px;" @bind-Value="Model!.input""></textarea>
                </label> 
                
            </div> 
            <div> 
                <button type="submit">Submit</button> 
            </div> 
        </form> 
    </div> 
    @if (flaxcodeModel.FlaxcodeBase64 == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <p>@flaxcodeModel.FlaxcodeInputString</p>

        <img src="@flaxcodeModel.FlaxcodeBase64" />

    }
</body>

@code {


    [SupplyParameterFromForm]
    private FlaxcodeInputHolder? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    private FlaxcodeModel flaxcodeModel = new FlaxcodeModel(input: "");
    private async Task Submit(){
        if(Model == null){
            //very brute force way of ensuring it's not null and appeasing the compiler
            Model ??= new();
        }
        flaxcodeModel.FlaxcodeInputString = Model.input;
        flaxcodeModel = await FlaxcodeApi.GetFlaxcodeAsync(flaxcodeModel);
    }

    public class FlaxcodeInputHolder
    {
        public string? input { get; set; }
    }
}

@page "/flaxcode"
@using flaxseed_web.Web;
@using flaxseed_web.Web.Models;
@using SixLabors.ImageSharp;
@using SixLabors.ImageSharp.PixelFormats;
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]

@inject FlaxcodeApiClient FlaxcodeApi
@{
    var imgsrc = "";
}

<PageTitle>Flaxcode</PageTitle>

<h1>Flaxcode</h1>
@* TODO: text entry goes here.*@

@if (flaxcodeModel.FlaxcodeBase64 == null)
{
    <p><em>Loading...</em></p>
}
else
{
    imgsrc = flaxcodeModel.FlaxcodeBase64;
    
    <div>
        @*
            TODO: put an input text box here. pass its input value into the FlaxcodeModel below.
        *@
        <p>@flaxcodeModel.FlaxcodeInputString</p>
        
        <img src="@imgsrc" />
    </div>
    

}


@code {

    private FlaxcodeModel flaxcodeModel = new FlaxcodeModel(input: "hard coded text input");

    protected override async Task OnInitializedAsync()
    {
        flaxcodeModel = await FlaxcodeApi.GetFlaxcodeAsync(flaxcodeModel);
    }
}

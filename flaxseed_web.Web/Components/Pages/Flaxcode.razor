@page "/flaxcode"
@using flaxseed_web.Web;
@using flaxseed_web.Web.Models;
@using SixLabors.ImageSharp;
@using SixLabors.ImageSharp.PixelFormats;
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]

@inject FlaxcodeApiClient FlaxcodeApi

<PageTitle>Flaxcode</PageTitle>

<h1>Flaxcode</h1>
@* TODO: text entry goes here.*@

@if (flaxcode_model.FlaxcodeOutput == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>@flaxcode_model.FlaxcodeInput</p>
    <p>@flaxcode_model.FlaxcodeOutput</p>
}


@code {

    private FlaxcodeModel flaxcode_model = new FlaxcodeModel();

    protected override async Task OnInitializedAsync()
    {
        flaxcode_model = await FlaxcodeApi.GetFlaxcodeAsync(new FlaxcodeModel("hardcoded test input"));
    }
}
